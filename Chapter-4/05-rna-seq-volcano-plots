# ==========================================
# CUSTOM VOLCANO PLOT FUNCTION
# ==========================================
generate_custom_volcano <- function(data_frame, title_text, chip_targets, top_n = 3) {
  
  # Remove rows containing NA values in our primary metrics
  plot_data <- data_frame[!is.na(data_frame$padj) & !is.na(data_frame$log2FoldChange), ]
  
  # Map standard colors based entirely on statistical significance (FDR < 0.05)
  key_colors <- rep('grey', nrow(plot_data))
  names(key_colors) <- rep('NS', nrow(plot_data))
  
  up_regulated <- plot_data$log2FoldChange > 0 & plot_data$padj < 0.05
  key_colors[up_regulated] <- 'red'
  names(key_colors)[up_regulated] <- 'Upregulated'
  
  down_regulated <- plot_data$log2FoldChange < 0 & plot_data$padj < 0.05
  key_colors[down_regulated] <- 'blue'
  names(key_colors)[down_regulated] <- 'Downregulated'
  
  # --- STRICT LABEL SELECTION ---
  # 1. Clean up decimal versions from workbook names just for matching safety
  clean_rna_symbols <- sub("\\..*", "", plot_data$Gene_Symbol)
  
  # 2. Match only if it passed the FDR threshold AND is found in the raw target list
  significant_mask <- plot_data$padj < 0.05
  matching_mask    <- clean_rna_symbols %in% chip_targets
  
  # Isolate all valid significant ChIP targets first
  targets_df <- plot_data[significant_mask & matching_mask, ]
  
  if (!is.null(top_n) && nrow(targets_df) > 0) {
    # Extract Top Upregulated by highest Log2FC magnitude
    up_targets <- targets_df[targets_df$log2FoldChange > 0, ]
    top_up <- if(nrow(up_targets) > 0) head(up_targets$Gene_Symbol[order(-up_targets$log2FoldChange)], top_n) else c()
    
    # Extract Top Downregulated by lowest (most negative) Log2FC magnitude
    down_targets <- targets_df[targets_df$log2FoldChange < 0, ]
    top_down <- if(nrow(down_targets) > 0) head(down_targets$Gene_Symbol[order(down_targets$log2FoldChange)], top_n) else c()
    
    genes_to_label <- c(top_up, top_down)
  } else {
    genes_to_label <- targets_df$Gene_Symbol
  }
  
  hmgn1_match <- plot_data$Gene_Symbol[clean_rna_symbols == "HMGN1"]
  if (length(hmgn1_match) > 0) {
    genes_to_label <- unique(c(genes_to_label, hmgn1_match))
  }
  
  if (length(genes_to_label) == 0) {
    genes_to_label <- NULL
  }
  
  # Render the plot layout
  p <- EnhancedVolcano(plot_data,
                       lab = plot_data$Gene_Symbol,
                       x = 'log2FoldChange',
                       y = 'padj',
                       pCutoff = 0.05,                   
                       FCcutoff = 0,                     
                       xlim = c(-10, 10),                
                       title = title_text,
                       subtitle = NULL,
                       caption = NULL,
                       xlab = bquote(~Log[2]~ 'FC'),
                       ylab = bquote(~-Log[10]~ 'FDR'),
                       colCustom = key_colors,
                       colAlpha = 0.5,                   
                       pointSize = 2.0,
                       cutoffLineType = 'dashed',
                       cutoffLineWidth = 0.5,
                       
                       # --- LABEL CONTROLS & CONNECTOR LINES ---
                       selectLab = genes_to_label,       
                       labSize = 3.5,                     
                       drawConnectors = TRUE,            
                       widthConnectors = 0.5,            
                       colConnectors = 'black',          
                       arrowheads = FALSE,
                       max.overlaps = Inf)
  return(p)
}

