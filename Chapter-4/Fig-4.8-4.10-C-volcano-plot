# ==========================================
# 2. THE PRODUCTION-READY FUNCTION
# ==========================================
make_volcano_plot <- function(df, display_title, cell_colors, y_max) {
  
  # A. Categorize genes using your updated label name
  df <- df %>%
    mutate(
      Gene_Class = case_when(
        Gene %in% canonical_hypoxia ~ "HALLMARK_HYPOXIA",
        log10padj > 1.3 & abs(log2FC) > 1 ~ "Non-Canonical Target",
        TRUE ~ "Not Significant"
      ),
      Gene_Class = factor(Gene_Class, levels = c("Not Significant", "Non-Canonical Target", "HALLMARK_HYPOXIA"))
    )
  
  # B. Identify top 5 enriched genes
  top5_genes <- df %>%
    filter(log10padj > 1.3 & log2FC > 0) %>%
    arrange(desc(log2FC)) %>% 
    head(5) %>%
    pull(Gene)
  
  df <- df %>%
    mutate(Label = if_else(Gene %in% top5_genes, as.character(Gene), ""))
  
  # C. Create the plot
  ggplot(df, aes(x = log2FC, y = log10padj, color = Gene_Class)) +
    geom_point(aes(size = Gene_Class, alpha = Gene_Class)) +
    
    scale_color_manual(
      values = cell_colors,
      breaks = c("Non-Canonical Target", "HALLMARK_HYPOXIA")
    ) +
    scale_size_manual(values = c("HALLMARK_HYPOXIA" = 3.0, "Non-Canonical Target" = 1.8, "Not Significant" = 1.2), guide = "none") +
    scale_alpha_manual(values = c("HALLMARK_HYPOXIA" = 0.95, "Non-Canonical Target" = 0.75, "Not Significant" = 0.40), guide = "none") +
    
    geom_vline(xintercept = c(-1, 1), linetype = "dashed", color = "gray50", linewidth = 0.4) +
    geom_hline(yintercept = 1.3, linetype = "dashed", color = "gray50", linewidth = 0.4) +
    
    geom_text_repel(aes(label = Label), color = "black", size = 5, fontface = "bold",
                    box_padding = 0.4, point_padding = 0.3, segment.color = "gray30", segment.linewidth = 0.4, max.overlaps = Inf) +
    
    # Custom axes configuration
    xlim(x_limits) + 
    ylim(c(0, y_max)) +
    
    # Title, added cleaner axis labels, and removed legend header text
    labs(title = display_title, 
         x = expression(bold(log[2](FC))), 
         y = expression(bold(-log[10](p.adj))),
         color = NULL) +
    
    theme_bw() +
    theme(
      
      plot.title = element_text(size = 22, face = "bold", hjust = 0.5, margin = margin(b = 10)),
      
      axis.title.x = element_text(size = 13, face = "bold"),
      axis.title.y = element_text(size = 13, face = "bold"),
      
      legend.position = "bottom", 
      legend.direction = "horizontal",
      legend.text = element_text(size = 15, face = "bold"), 
      
      panel.grid.minor = element_blank(), 
      panel.grid.major = element_line(color = "gray95"),
      
      panel.background = element_rect(fill = alpha("white", 0.25), color = NA),
      plot.background  = element_rect(fill = alpha("white", 0.25), color = NA),
      legend.background = element_rect(fill = alpha("white", 0.25), color = NA)
    ) +
    guides(color = guide_legend(override.aes = list(size = 4, alpha = 1))) 
}

