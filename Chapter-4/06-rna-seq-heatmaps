# ==============================================================================
# 7. DIRECTIONAL HYPOXIA/CHIP-SEQ HEATMAP PLOTTER FUNCTION
# ==============================================================================
generate_directional_combined_heatmap <- function(cell_line_name, raw_res_kd, direction = "down", filename_out) {
  
  # A. Subset expression matrix to only include samples for THIS cell line
  samples_to_keep <- colnames(vsd_matrix)[col_data$cell_line == cell_line_name]
  if (length(samples_to_keep) == 0) stop("No samples found for: ", cell_line_name)
  
  sub_matrix <- vsd_matrix[, samples_to_keep, drop = FALSE]
  
  # B. Order columns logically: Normoxia -> Control Hypoxia -> KD Hypoxia
  target_order <- c("HMGN1 Ctrl normoxia", "HMGN1 Ctrl hypoxia", "HMGN1 KD hypoxia")
  sort_df <- annotation_data[samples_to_keep, , drop = FALSE]
  sort_df$Condition <- factor(sort_df$Condition, levels = target_order)
  ordered_samples <- rownames(sort_df[order(sort_df$Condition), , drop = FALSE])
  
  sub_matrix <- sub_matrix[, ordered_samples, drop = FALSE]
  sub_annotation <- sort_df[ordered_samples, , drop = FALSE]
  
  colnames(sub_annotation) <- "Condition"
  rownames(sub_annotation) <- ordered_samples
  
  # C. Simplify column sample names for clean plotting display
  cond_list <- as.character(sub_annotation$Condition)
  simplified_names <- ave(cond_list, cond_list, FUN = function(x) {
    prefix <- switch(x[1],
                     "HMGN1 Ctrl normoxia" = "ctrl_norm",
                     "HMGN1 Ctrl hypoxia"  = "ctrl_hyp",
                     "HMGN1 KD hypoxia"    = "kd_hyp")
    paste0(prefix, "_", seq_along(x))
  })
  colnames(sub_matrix) <- simplified_names
  rownames(sub_annotation) <- simplified_names
  
  # D. Extract and filter DEGs on the HMGN1 KD contrast
  res_kd <- raw_res_kd[!is.na(raw_res_kd$padj), ]
  sig_kd_degs <- rownames(res_kd)[res_kd$padj < 0.05]
  
  # Match cell-line-specific ChIP-seq list
  chip_genes <- if (cell_line_name == "THP1") thp1_chip_genes else kasumi_chip_genes
  
  # Combine Hallmark Hypoxia and ChIP-seq target lists (union)
  combined_target_list <- union(hallmark_hypoxia_genes, chip_genes)
  
  # Intersect significant DEGs with our combined targets
  matched_genes <- intersect(sig_kd_degs, combined_target_list)
  matched_genes <- intersect(matched_genes, rownames(sub_matrix))
  
  # Isolate genes by target directionality
  if (direction == "up") {
    selected_genes <- matched_genes[res_kd[matched_genes, "log2FoldChange"] > 0]
    title_suffix <- ": HALLMARK_HYPOXIA & ChIP-seq Targets"
  } else if (direction == "down") {
    selected_genes <- matched_genes[res_kd[matched_genes, "log2FoldChange"] < 0]
    title_suffix <- ": HALLMARK_HYPOXIA & ChIP-seq Targets"
  } else {
    stop("Invalid direction selected. Choose 'up' or 'down'.")
  }
  
  if (length(selected_genes) == 0) {
    message("--> [Warning] No significant ", direction, "regulated targets found for ", cell_line_name, ". Skipping.")
    return(NULL)
  }
  
  # E. Rank genes by absolute magnitude of Fold Change and select Top 50
  lfc_values <- abs(res_kd[selected_genes, "log2FoldChange"])
  names(lfc_values) <- selected_genes
  top_genes <- names(sort(lfc_values, decreasing = TRUE))[1:min(50, length(lfc_values))]
  
  heatmap_data <- sub_matrix[top_genes, , drop = FALSE]
  
  # F. Create styled row labels using R's plotmath engine
  row_labels <- as.expression(lapply(top_genes, function(g) {
    is_hallmark <- g %in% hallmark_hypoxia_genes
    is_chip     <- g %in% chip_genes
    
    if (is_hallmark && is_chip) {
      # In both lists: Bold and Underlined
      bquote(underline(bold(.(g))))
    } else if (is_chip) {
      # ChIP-seq target only: Bold
      bquote(bold(.(g)))
    } else {
      # Hallmark Hypoxia only: Plain Text
      bquote(.(g))
    }
  }))
  
  # Map pretty display titles
  display_title_name <- switch(cell_line_name, "THP1" = "THP-1", "Kasumi1" = "Kasumi-1", cell_line_name)
  
  # G. Render and print the heatmap
  pheatmap(
    heatmap_data,
    scale = "row",
    cluster_cols = FALSE,
    annotation_col = sub_annotation,
    annotation_colors = annotation_colors,
    show_colnames = TRUE,
    labels_row = row_labels,        # Inject our custom plotmath expressions
    main = paste0(display_title_name, title_suffix),
    color = colorRampPalette(c("blue", "white", "red"))(100),
    filename = filename_out,
    width = 8,
    height = 10,
    dpi = 300
  )
  
  if (!is.null(dev.list())) dev.off()
}

